{
  "name": "@ts-stack/type-is",
  "type": "module",
  "version": "1.0.2",
  "description": "A fork of the widely used `type-is` library, but this one accepts headers instead of a request object.",
  "exports": "./dist/index.js",
  "repository": "https://github.com/ts-stack/type-is",
  "scripts": {
    "start": "npm run build && node dist/index.js",
    "test": "npm run build && npm run esm-jest",
    "esm-jest": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "build": "tsc -b tsconfig.build.json",
    "clean": "rimraf dist*"
  },
  "keywords": [
    "ts-stack",
    "mime"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "content-type": "^2.0.0",
    "mime-types": "^3.0.2"
  },
  "devDependencies": {
    "@types/content-type": "^1.1.9",
    "@types/eslint": "^9.6.1",
    "@types/jest": "^30.0.0",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^25.7.0",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "eslint": "^10.3.0",
    "jest": "^30.4.2",
    "prettier": "^3.8.3",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">= 20.6.0"
  },
  "packageManager": "yarn@4.14.1"
}